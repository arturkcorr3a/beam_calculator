{
    "python.analysis.autoImportCompletions": true,
    "terminal.integrated.env.linux": {
        "PYTHONPATH": "${workspaceFolder}"
    },
    "cSpell.words": [
        "ABNT",
        "absmax",
        "Armado",
        "Autoclaved",
        "autouse",
        "Branson",
        "Branson's",
        "Cálculo",
        "carvalho",
        "centerlines",
        "Chust",
        "Concreto",
        "constructability",
        "Detalhamento",
        "Estruturas",
        "fctd",
        "fctk",
        "fctm",
        "Figueiredo",
        "Filho",
        "fywd",
        "fywk",
        "indeterminatebeam",
        "Jasson",
        "kncm",
        "monkeypatching",
        "Quadro",
        "Rebar",
        "rebars",
        "Rodrigues",
        "Rüsch",
        "SINAPI",
        "solveset",
        "UDLV",
        "uncracked",
        "Usuais"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    "todo-tree.general.tags": [
        "FIXME",
        "TODO",
        "[ ]",
        "[x]",
        "IMPLEMENT",
        "CONFIRM",
        "REVIEW",
        "ASK",
        "NOTE",
        "REFACTOR",
        "PAPER",
    ],
    "python.analysis.typeCheckingMode": "strict",
    "workbench.colorTheme": "Dark Modern",
}